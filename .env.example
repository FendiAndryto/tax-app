# Docker Compose settings for the isolated tax-app stack.
# Copy to `.env` (same folder as docker-compose.yml) and adjust if a port is taken.
#
# All host ports below are reserved for tax-app only and do not collide with the
# sibling `accounting-system` project (which uses 3306 / 8000 / 8081).

# MySQL exposed on the host
DB_EXTERNAL_PORT=3307

# Laravel API exposed on the host
BACKEND_PORT=8001

# phpMyAdmin exposed on the host
PMA_PORT=8082

# Database credentials (kept separate from accounting-system)
DB_ROOT_PASSWORD=rootpassword
DB_DATABASE=tax_app_db
DB_USERNAME=tax_app_user
DB_PASSWORD=tax_app_password
